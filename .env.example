//arme este .example para que no se suba el .env con la clave de JWT y otros datos.

PORT=3000

# Origenes permitidos por CORS: 5500 y 5501 son los puertos de Live Server
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Clave secreta para firmar los tokens (JWT).
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET= 

# Cuanto dura la sesion antes de tener que volver a iniciar sesion
JWT_EXPIRA=2h